{
  "name": "tecnicelu-storefront",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint && bash scripts/brand-check.sh",
    "worker:test": "node --test worker/src/*.test.js worker/src/platform/*.test.js",
    "preview": "npm run build && vite preview",
    "cloudflare:whoami": "wrangler whoami",
    "deploy:preview": "wrangler deploy --config worker/wrangler.toml --env preview && VITE_API_BASE=https://tecnicelu-preview.parchepaisa.workers.dev VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA npm run build -- --mode preview && wrangler pages deploy dist --project-name tecnicelu --branch preview --commit-dirty=true",
    "cloudflare:setup-vapid": "node scripts/setup-vapid-secrets.mjs",
    "worker:deploy": "cd worker && npm run deploy",
    "tecnicelu:secrets": "node scripts/tecnicelu-secrets.mjs",
    "ai:secrets": "node scripts/ai-secrets.mjs",
    "demo": "npm run deploy:preview && npm run demo:video",
    "demo:video": "node scripts/record-chatbot-video.mjs",
    "demo:live": "node scripts/demo-live.mjs",
    "demo:site": "node scripts/record-site-demo.mjs",
    "demo:tour": "node scripts/record-customer-tour.mjs",
    "demo:admin": "node scripts/record-admin-demo.mjs",
    "demo:showcase": "node scripts/concatenate-demos.mjs",
    "demo:full": "node scripts/full-demo-pipeline.mjs",
    "demo:prod": "node scripts/demo-full-prod.mjs",
    "admin:auth:prod": "node scripts/create-prod-auth.mjs",
    "demo:intro": "INTRO_UPLOAD=1 node scripts/make-showcase-scenes.mjs",
    "video:webm": "node scripts/convert-video-webm.mjs",
    "admin:walkthrough": "npx playwright test --config playwright.admin.config.ts",
    "admin:walkthrough:auth": "npx playwright test --config playwright.admin.config.ts --project=admin-auth-setup --headed",
    "logo:webp": "node scripts/download-logo-webp.mjs"
  },
  "dependencies": {
    "@fontsource/oxanium": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@types/jszip": "^3.4.0",
    "fuse.js": "^7.5.0",
    "jszip": "^3.10.1",
    "lucide-react": "^1.31.0",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "react-router-dom": "^7.18.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "autoprefixer": "^10.5.4",
    "oxlint": "^1.75.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "wrangler": "^4.147.0"
  }
}
